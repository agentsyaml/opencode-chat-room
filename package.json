{
  "name": "@alexsun-top/opencode-chat-room",
  "version": "0.5.5",
  "description": "A chat-room plugin and central server for OpenCode.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentsyaml/opencode-chat-room.git"
  },
  "module": "index.ts",
  "type": "module",
  "main": "./plugin.ts",
  "exports": {
    ".": "./index.ts",
    "./server": "./plugin.ts",
    "./plugin": "./plugin.ts",
    "./chat-server": "./server/chat-server.ts"
  },
  "bin": {
    "opencode-chat-room": "cli.ts"
  },
  "files": [
    "cli.ts",
    "plugin.ts",
    "index.ts",
    "src",
    "!src/**/*.test.ts",
    "skills/chatroom/SKILL.md",
    "server/chat-server.ts",
    "server/json-body.ts",
    "server/inbox.ts",
    "server/history-route.ts",
    "server/newrooms.ts",
    "server/member-routes.ts",
    "server/announcement-routes.ts",
    "server/resource-routes.ts",
    "server/admin-routes.ts",
    "server/admin-state.ts",
    "server/admin-auth.ts",
    "server/room-reminders.ts",
    "server/wake.ts",
    "server/chat.html",
    "server/assets",
    "CHANGELOG.md",
    "docs/administrator-rooms.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "server": "bun run server/chat-server.ts",
    "test": "for file in src/*.test.ts server/*.test.ts; do bun test \"$file\" || exit; done",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.29",
    "@types/bun": "latest",
    "playwright": "1.64.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.29",
    "@opencode/client": "2.0.32",
    "croner": "11.0.0",
    "zod": "4.1.8"
  }
}
