# Shared server token. Required by Compose; the stack refuses to start without it.
# CHAT_ROOM_SERVER_TOKEN=change-me

# Resource storage: local (default) or s3.
CHAT_ROOM_STORAGE=local

# Required when CHAT_ROOM_STORAGE=s3. Never commit real credentials.
# CHAT_ROOM_S3_BUCKET=
# CHAT_ROOM_S3_ACCESS_KEY_ID=
# CHAT_ROOM_S3_SECRET_ACCESS_KEY=

# Optional S3 settings.
# CHAT_ROOM_S3_ENDPOINT=https://s3.example.com
# CHAT_ROOM_S3_REGION=us-east-1
# CHAT_ROOM_S3_FORCE_PATH_STYLE=true
# CHAT_ROOM_S3_PREFIX=chat-room

# Keep a local cache copy for faster reads and S3-outage tolerance.
# 0, false, or off disables the cache.
# CHAT_ROOM_S3_LOCAL_CACHE=1

# Maximum tasks per room (positive integer). At the cap, new tasks are rejected
# until an existing task is deleted.
# CHAT_ROOM_MAX_ROOM_TASKS=10

# Docker Compose image and port overrides.
# DOCKER_REGISTRY=ghcr.io
# SERVICE_NAME=agentsyaml/opencode-chat-room
# BUILD_VERSION=v0.8.1
# CHAT_ROOM_PORT_OVERRIDE=4399

# Optional PostgreSQL profile; start with --profile postgres.
# CHAT_ROOM_DATABASE_URL=postgresql://chatroom:CHANGEME@postgres:5432/chatroom
# POSTGRES_USER=chatroom
# POSTGRES_PASSWORD=CHANGEME
# POSTGRES_DB=chatroom
# POSTGRES_PORT_OVERRIDE=5432

# Optional RustFS profile; start with --profile rustfs.
# Set CHAT_ROOM_STORAGE=s3 and create the bucket before starting the app.
# CHAT_ROOM_S3_BUCKET=chat-room
# CHAT_ROOM_S3_ENDPOINT=http://rustfs:9000
# CHAT_ROOM_S3_ACCESS_KEY_ID=CHANGEME
# CHAT_ROOM_S3_SECRET_ACCESS_KEY=CHANGEME
# CHAT_ROOM_S3_FORCE_PATH_STYLE=true
# RUSTFS_ACCESS_KEY=CHANGEME
# RUSTFS_SECRET_KEY=CHANGEME
# RUSTFS_ADDRESS_PORT_OVERRIDE=9000
# RUSTFS_CONSOLE_PORT_OVERRIDE=9001