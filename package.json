{
  "name": "@alexsun-top/opencode-chat-room",
  "version": "0.8.2",
  "description": "A chat-room server, web client, terminal client, and OpenCode/Codex/dsh plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentsyaml/opencode-chat-room.git"
  },
  "module": "index.ts",
  "type": "module",
  "main": "./plugin.ts",
  "exports": {
    ".": "./index.ts",
    "./server": "./plugin.ts",
    "./plugin": "./plugin.ts",
    "./chat-server": "./server/chat-server.ts"
  },
  "bin": {
    "opencode-chat-room": "dist/cli.js"
  },
  "files": [
    "LICENSE",
    "cli.ts",
    "dist",
    "plugin.ts",
    "index.ts",
    "src",
    "packages/chat-room-channeld/src",
    "packages/chat-room-channeld/dist/mock-adapter.js",
    "!src/tests",
    "!src/**/*.test.*",
    "!src/tui/test",
    "skills/chatroom/SKILL.md",
    "server/chat-server.ts",
    "server/startup.ts",
    "server/routes",
    "server/app.ts",
    "server/channels.ts",
    "server/channel-attachments.ts",
    "server/channel-settings.ts",
    "server/channel-integration.ts",
    "server/http-server.ts",
    "server/json-body.ts",
    "server/inbox.ts",
    "server/history-route.ts",
    "server/addressing-routes.ts",
    "server/message-recall-routes.ts",
    "server/room-payload.ts",
    "server/room-owner.ts",
    "server/newrooms.ts",
    "server/join-requests.ts",
    "server/room-join.ts",
    "server/member-routes.ts",
    "server/task-routes.ts",
    "server/announcement-routes.ts",
    "server/resource-routes.ts",
    "server/admin-routes.ts",
    "server/admin-state.ts",
    "server/admin-auth.ts",
    "server/room-reminders.ts",
    "server/wake.ts",
    "server/chat.html",
    "server/manifest.webmanifest",
    "server/sw.js",
    "server/assets",
    "CHANGELOG.md",
    "docs/administrator-rooms.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:cli": "bun build cli.ts --target=node --packages external --outfile dist/cli.js >&2",
    "build:channeld-mock": "bun build packages/chat-room-channeld/src/mock-adapter.ts --target=node --packages external --outfile packages/chat-room-channeld/dist/mock-adapter.js >&2",
    "build:adapter-feishu": "bun scripts/build-feishu-adapter.ts",
    "build:monaco": "bun scripts/build-monaco.ts",
    "build:office": "bun scripts/build-office.ts",
    "prepack": "bun run build:cli && bun run build:channeld-mock && bun scripts/build-monaco.ts --quiet && bun scripts/build-office.ts --quiet",
    "server": "node cli.ts",
    "server:bun": "bun cli.ts",
    "server:deno": "deno run --allow-env --allow-read --allow-write --allow-net cli.ts",
    "test": "for file in src/tests/*.test.ts server/*.test.ts; do bun test \"$file\" || exit; done && bun test src/tui/test --isolate",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.29",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "docx-preview": "0.4.1",
    "jszip": "3.10.2",
    "monaco-editor": "0.58.0",
    "playwright": "1.64.1",
    "pptx-preview": "1.0.7",
    "shiki": "4.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@opencode-ai/plugin": "^1.18.29",
    "@opencode/client": "2.0.32",
    "@opentui/core": "0.2.16",
    "croner": "11.0.0",
    "pg": "^8.23.1",
    "yaml": "^2.9.0",
    "zod": "4.1.8"
  },
  "overrides": {
    "echarts": "6.1.0",
    "lodash": "4.18.1",
    "uuid": "11.1.1"
  }
}
